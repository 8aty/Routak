    },
    "Drives leaving then took %@ on average, %@ less than leaving around %@." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jízdy s odjezdem v tuto dobu trvaly v průměru %1$@, tedy o %2$@ méně než při odjezdu kolem %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drives leaving then took %1$@ on average, %2$@ less than leaving around %3$@."
          }
        }
      }
    },
    "Drives longer than %@ are saved here automatically. You can also start a trip from the Drive tab." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jízdy delší než %@ se sem ukládají automaticky. Jízdu můžete spustit i ručně na kartě Jízda."
          }
        }
      }
    },
    "Drives over %@ save automatically" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jízdy nad %@ se ukládají automaticky"
          }
        }
      }
    },
    "Drives that start at %@ and end at %@ show up here." : {
      "comment" : "Both arguments are saved place names",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí se tu jízdy, které začínají v místě „%1$@“ a končí v místě „%2$@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drives that start at %1$@ and end at %2$@ show up here."
          }
        }
      }
    },
    "Driving" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za volantem"
          }
        }
      }
    },
    "Driving again within 5 minutes of where a trip ended, after a gas stop for example, continues the same trip. Snapping uses Apple Maps directions to line routes up with roads, which helps in tunnels and between tall buildings. GPS records less often on highways to save battery." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se do 5 minut znovu rozjedete z místa, kde jízda skončila (třeba po zastávce u benzinky), pokračuje stejná jízda. Přichycení k silnicím zarovná trasy podle navigace z aplikace Mapy, což pomáhá v tunelech a mezi vysokými budovami. Na dálnicích zaznamenává GPS polohu méně často, aby šetřila baterii."
          }
        }
      }
    },
    "Driving motion detected" : {
      "localizations" : {
        "cs" : {

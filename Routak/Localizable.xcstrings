    "When you drive" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdy jezdíte"
          }
        }
      }
    },
    "When you start moving faster than about 23 km/h (15 mph), Routak begins recording. Shorter trips are discarded. Manual trips are always saved. While your phone still senses it's in a car, red lights and traffic jams don't end the trip." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakmile se rozjedete rychleji než zhruba 23 km/h, Routak začne zaznamenávat. Kratší jízdy se zahodí, ručně spuštěné se uloží vždy. Dokud telefon poznává, že je v autě, červená na semaforu ani kolona jízdu neukončí."
          }
        }
      }
    },

    "Add drives recorded by another app or device. Each track in a file becomes a trip. Trips that are already saved are skipped." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte jízdy zaznamenané jinou aplikací nebo zařízením. Každá trasa v souboru se uloží jako samostatná jízda. Jízdy, které už máte uložené, se přeskočí."
          }
        }
      }
    },

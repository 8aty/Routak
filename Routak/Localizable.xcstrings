    "Sync with iCloud" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizovat přes iCloud"
          }
        }
      }
    },
    "Tells you how far you've driven this week." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekne, kolik jste tento týden najezdili."
          }
        }
      }
    },
    "To start trips when your phone connects to CarPlay or your car's Bluetooth, make an automation in the Shortcuts app with Routak's Start Trip action." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li jízdu spouštět po připojení k CarPlay nebo k Bluetooth auta, vytvořte v aplikaci Zkratky automatizaci s akcí Spustit jízdu z Routaku."
          }
        }
      }
    },
    "Trip saved." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jízda uložena."
          }
        }
      }
    },
    "Trips and saved places sync to your other devices through your iCloud account." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jízdy a uložená místa se přes váš účet iCloud synchronizují do dalších zařízení."
          }
        }
      }
    },
    "Unavailable" : {
      "comment" : "iCloud account status",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedostupné"

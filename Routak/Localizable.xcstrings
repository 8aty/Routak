    "A %@ drive uses about %@ of fuel. Estimates appear on each trip and in Stats." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jízda dlouhá %1$@ spotřebuje palivo zhruba za %2$@. Odhady uvidíte u každé jízdy a ve Statistikách."

    "Your trips stay on your devices and in your own iCloud." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše jízdy zůstávají ve vašich zařízeních a ve vašem iCloudu."

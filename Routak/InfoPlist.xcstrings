    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte „Vždy“, aby Routak poznal, že vyjíždíte, a zaznamenal jízdu na pozadí, i když je aplikace zavřená."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose \"Always\" so Routak can notice when you start driving and record the trip in the background, even when the app is closed."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routak používá vaši polohu k zakreslení tras vašich jízd do mapy."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Routak uses your location to draw the route of your drives on a map."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routak podle údajů o pohybu pozná, že jedete autem. Díky tomu začne jízdu zaznamenávat dřív a ušetří baterii."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Routak uses motion activity to tell when you are in a car, so it can start recording drives sooner and save battery."
          }
        }
      }
    }
  },
  "version" : "1.0"
